# ─── Copiar a .env y completar ────────────────────────
# En Vercel/Railway/Render configurar como variables de entorno del proyecto
# NUNCA commitear el archivo .env real

# MongoDB Atlas (requerido en producción)
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster.mongodb.net/portal_clientes?retryWrites=true&w=majority

# JWT — generar con: openssl rand -hex 64
JWT_SECRET=<secreto_de_minimo_64_caracteres_aleatorios>

# Puerto (Vercel lo ignora; Railway/Render lo usa)
PORT=3000

# CORS — URL del frontend en producción (ej: https://portal4.vercel.app)
CORS_ORIGIN=https://tu-frontend.vercel.app

# Entorno
NODE_ENV=production

# Correo — contraseña de APP (no la contraseña de la cuenta)
# Crear en: myaccount.google.com/apppasswords
MAIL_USER=tucuenta@gmail.com
MAIL_PASS=<contraseña_de_app_16_caracteres>
